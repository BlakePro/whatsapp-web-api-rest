{
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!.next", "!dist", "!public", "!*.json", "!.agents", "!.claude"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 300,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "noMisleadingCharacterClass": "off",
        "noThenProperty": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useImportType": "off",
        "useTemplate": "off",
        "noParameterAssign": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single"
    }
  }
}
